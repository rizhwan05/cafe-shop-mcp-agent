note over Exceptions
AppBaseException.__init__(error_code, message, status_code):
  Sets self.error_code, self.message, self.status_code
  Calls super().__init__(self.message)

DatabaseConnectionException.__init__(detail):
  Calls ErrorCodeStatus.get(ErrorCode.DB_CONNECTION_FAILED, "BB_DB_001") → "BB_DB_001"
  Calls super().__init__(error_code="BB_DB_001", message=detail, status_code=settings.http_service_unavailable)

MenuItemNotFoundException.__init__(item_name):
  Calls ErrorCodeStatus.get(ErrorCode.MENU_ITEM_NOT_FOUND, "BB_MENU_001") → "BB_MENU_001"
  Calls super().__init__(error_code="BB_MENU_001", message="Menu item '{item_name}' not found.", status_code=settings.http_not_found)

OrderNotFoundException.__init__(order_id):
  Calls ErrorCodeStatus.get(ErrorCode.ORDER_NOT_FOUND, "BB_ORD_001") → "BB_ORD_001"
  Calls super().__init__(error_code="BB_ORD_001", message="Order '{order_id}' not found.", status_code=settings.http_not_found)

InsufficientStockException.__init__(item_name, available):
  Calls ErrorCodeStatus.get(ErrorCode.INSUFFICIENT_STOCK, "BB_ORD_002") → "BB_ORD_002"
  Calls super().__init__(error_code="BB_ORD_002", message="Insufficient stock for '{item_name}'. Available: {available}.", status_code=settings.http_bad_request)

InvalidRequestException.__init__(detail):
  Calls ErrorCodeStatus.get(ErrorCode.INVALID_REQUEST, "BB_REQ_001") → "BB_REQ_001"
  Calls super().__init__(error_code="BB_REQ_001", message=detail, status_code=settings.http_bad_request)

Imports:
- utils.exceptions.error_codes: ErrorCode, ErrorCodeStatus
end note

